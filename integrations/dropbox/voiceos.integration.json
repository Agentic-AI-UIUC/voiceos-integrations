            }
          ]
        }
      }
    },
    {
      "name": "connection_status",
      "title": "Dropbox account status",
      "description": "Check this Dropbox OAuth2 connection. Use when the user asks whether Dropbox is connected or needs reauthorization. Read only; does not start OAuth or change files.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      }
    },
    {
      "name": "disconnect_account",
      "title": "Disconnect Dropbox",
      "description": "Disconnect the saved Dropbox account in Composio. Use only when the user explicitly asks to disconnect or unlink Dropbox. Does not delete Dropbox files.",
