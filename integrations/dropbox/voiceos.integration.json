              ]
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
                  "role": "cancel"
                },
                {
                  "label": "Disconnect Dropbox",
                  "role": "confirm",
                  "color": "accent"
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "icon": "icon.png",
  "setupGuide": {
    "title": "Connect Dropbox with Composio OAuth2",
    "collapsedByDefault": false,
    "blocks": [
      {
        "type": "text",
        "text": "Save your Composio API key, then ask VoiceOS to connect Dropbox. Approve the confirmation card and authorize Dropbox in your browser. Ask for Dropbox connection status to verify. You can ask VoiceOS to disconnect Dropbox. Fallback: run npm run setup in this integration folder to use the local Connect/Disconnect page, then copy its active connected account ID (normally ca_...) into Setup and Reload. A pg-test-... identifier is not a connected account ID."
      }
    ]
  }
}
