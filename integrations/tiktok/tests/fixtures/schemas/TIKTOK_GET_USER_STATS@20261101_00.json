{
  "slug": "TIKTOK_GET_USER_STATS",
  "name": "Get user stats",
  "toolkit": {
    "slug": "tiktok",
    "name": "tiktok",
    "logo": "https://logos.composio.dev/api/tiktok"
  },
  "description": "Fetches TikTok user information and statistics for the authenticated user. Retrieves user stats (follower_count, following_count, likes_count, video_count) and can optionally fetch profile fields (display_name, username, bio_description, etc.) and basic info (open_id, union_id, avatar URLs). Returns only the fields requested in the fields parameter. Only works for the authenticated account; cannot fetch arbitrary public profiles. Stats may be delayed and not reflect the most recent activity.",
  "input_parameters": {
    "type": "object",
    "title": "GetUserStatsRequest",
    "properties": {
      "fields": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "title": "Fields",
        "description": "List of fields to retrieve. Available fields: Stats fields (user.info.stats scope): follower_count, following_count, likes_count, video_count. Profile fields (user.info.profile scope): username, bio_description, profile_deep_link, is_verified. Basic fields (user.info.basic scope): open_id, union_id, avatar_url, avatar_url_100, avatar_large_url, display_name. Defaults to the 4 statistics fields. Requesting fields without the corresponding OAuth scope returns missing or incomplete data for those fields."
      }
    }
  },
  "output_parameters": {
    "type": "object",
    "$defs": {
      "UserInfo": {
        "type": "object",
        "title": "UserInfo",
        "properties": {
          "open_id": {
            "type": "string",
            "title": "Open Id",
            "description": "The unique identification of the user in the current application"
          },
          "union_id": {
            "type": "string",
            "title": "Union Id",
            "description": "Persistent ID across apps from same developer"
          },
          "username": {
            "type": "string",
            "title": "Username",
            "description": "User's account name"
          },
          "avatar_url": {
            "type": "string",
            "title": "Avatar Url",
            "description": "User profile image"
          },
          "is_verified": {
            "type": "boolean",
            "title": "Is Verified",
            "description": "Whether account has verified badge"
          },
          "likes_count": {
            "type": "integer",
            "title": "Likes Count",
            "description": "Total likes across all videos"
          },
          "video_count": {
            "type": "integer",
            "title": "Video Count",
            "description": "Total public videos posted"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name",
            "description": "User profile name"
          },
          "avatar_url_100": {
            "type": "string",
            "title": "Avatar Url 100",
            "description": "Profile image at 100x100 resolution"
          },
          "follower_count": {
            "type": "integer",
            "title": "Follower Count",
            "description": "Total followers"
          },
          "bio_description": {
            "type": "string",
            "title": "Bio Description",
            "description": "User bio if available"
          },
          "following_count": {
            "type": "integer",
            "title": "Following Count",
            "description": "Accounts user follows"
          },
          "avatar_large_url": {
            "type": "string",
            "title": "Avatar Large Url",
            "description": "Higher resolution profile image"
          },
          "profile_deep_link": {
            "type": "string",
            "title": "Profile Deep Link",
            "description": "Link to user's TikTok profile page"
          }
        },
        "description": "User information and statistics returned by TikTok API."
      },
