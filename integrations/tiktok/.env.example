# The integration's setup fields. All four are temporary: remove them before release.
# In VoiceOS you set them under Integrations → TikTok → Configure, and VoiceOS passes
# them to server.ts as environment variables. This file only lists the names.
#
# Bun loads a .env in this folder automatically (for `bun server.ts`, `bun test`, and
# VoiceOS's own launch), and it fills any setting VoiceOS leaves empty. Never commit
# a .env (the club CI fails on one), and don't keep real values in it while running tests.

# Composio project API key (not a ck_ or uak_ key). Password field.
COMPOSIO_API_KEY=
# The Composio user_id the TikTok account is connected under. Empty means "default".
COMPOSIO_USER_ID=
# The ACTIVE TikTok connection id from Composio → Connected accounts (ca_…).
COMPOSIO_CONNECTED_ACCOUNT_ID=
# Media relay token for photo carousels. Leave empty until the relay exists. Password field.
MEDIA_RELAY_TOKEN=
