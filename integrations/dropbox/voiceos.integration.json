{
  "schemaVersion": 1,
  "id": "com.voiceos.generated.dropbox",
  "version": "2.0.17",
  "name": "Dropbox",
  "summary": "Find, read, upload, organize, version and share Dropbox files through Composio OAuth2.",
  "supportedPlatforms": [
    "darwin",
    "win32"
  ],
  "publisher": {
    "id": "pub_user",
    "name": "Made in VoiceOS"
  },
  "runtime": {
    "kind": "local-mcp",
    "command": "/bin/zsh",
    "args": [
      "run.sh"
    ]
  },
  "permissions": [
    {
      "kind": "network",
      "domains": [
        "backend.composio.dev",
        "*.r2.cloudflarestorage.com"
      ]
    },
    {
      "kind": "background"
    }
  ],
  "preferences": [
    {
      "name": "COMPOSIO_API_KEY",
      "title": "Composio API key",
      "description": "Your Composio project API key. Save it here; never paste Dropbox tokens. Reload after saving.",
      "type": "password",
      "required": true
    },
    {
      "name": "COMPOSIO_CONNECTED_ACCOUNT_ID",
      "title": "Dropbox connected account ID (manual fallback)",
      "description": "Optional: an active Dropbox OAuth2 connection ID from Composio (normally ca_...). Leave blank when using the Connect Dropbox voice tool. This is not a project, playground, or user ID.",
      "type": "text",
      "required": false
    }
  ],
  "tools": [
    {
      "name": "list_files",
      "title": "List files in folder",
      "description": "List files in folder via Composio OAuth2. Use when the user asks to browse a Dropbox folder. Returns provider data including pagination; never infer all pages were read. The card already shows the returned items. Keep default narration brief and do not repeat the entire list unless the user explicitly asks for those details.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "default": ""
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      }
    },
    {
      "name": "search_files",
      "title": "Search files and folders",
      "description": "Search files and folders via Composio OAuth2. Use when the user asks to find Dropbox files or folders by keyword. Returns provider data including pagination; never infer all pages were read. The card already shows the returned items. Keep default narration brief and do not repeat the entire list unless the user explicitly asks for those details.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      }
    },
    {
      "name": "get_metadata",
      "title": "Get file or folder metadata",
      "description": "Get file or folder metadata via Composio OAuth2. Use when the user asks to inspect Dropbox file or folder metadata. Returns provider data including pagination; never infer all pages were read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      }
    },
    {
      "name": "read_file",
      "title": "Read a file",
      "description": "Read a file via Composio OAuth2. Use when the user asks to read a Dropbox file; Word .docx files up to 20 MiB return extracted readable text, while other binary formats return a file reference. Returns provider data including pagination; never infer all pages were read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      }
    },
    {
      "name": "upload_file",
      "title": "Upload File",
      "description": "Upload File via Composio OAuth2. Use when the user asks to upload an existing local file from an allowed home folder to Dropbox; overwrite requires explicit approval. Returns provider data including pagination; never infer all pages were read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Full existing local file path under your home Desktop, Documents, Downloads, Pictures, Movies, Videos, or Music folder, without surrounding quotes or brackets. Supports binary Word/PDF/image files up to 50 MiB; never invent a file reference."
          },
          "mode": {
            "type": "string",
            "enum": [
              "add",
              "overwrite"
            ],
            "default": "add"
          }
        },
        "required": [
          "path",
          "file"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      },
      "confirmation": {
        "schemaVersion": 1,
        "root": {
          "type": "card",
          "title": "Upload File",
          "children": [
            {
              "type": "stack",
              "direction": "vertical",
              "gap": "md",
              "children": [
                {
                  "type": "text",
                  "text": "Add stops if the destination exists. Overwrite replaces its contents.",
                  "color": "muted"
                },
                {
                  "type": "textField",
                  "bind": "{{path}}",
                  "label": "Destination path",
                  "required": true
                },
                {
                  "type": "text",
                  "text": "Selected source: {{file}}",
                  "color": "muted"
                },
                {
                  "type": "textField",
                  "bind": "{{file}}",
                  "label": "Local source file",
                  "required": true
                },
                {
                  "type": "select",
                  "bind": "{{mode}}",
                  "label": "Upload behavior",
                  "options": [
                    {
                      "label": "Add (stop if file exists)",
                      "value": "add"
                    },
                    {
                      "label": "Overwrite existing file",
                      "value": "overwrite"
                    }
                  ]
                }
              ]
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
                  "role": "cancel"
                },
                {
                  "label": "Upload File",
                  "role": "confirm",
                  "color": "accent"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "create_folder",
      "title": "Create folder",
      "description": "Create folder via Composio OAuth2. Use when the user asks to create a Dropbox folder. Returns provider data including pagination; never infer all pages were read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      },
      "confirmation": {
        "schemaVersion": 1,
        "root": {
          "type": "card",
          "title": "Create folder",
          "children": [
            {
              "type": "stack",
              "direction": "vertical",
              "gap": "md",
              "children": [
                {
                  "type": "text",
                  "text": "Review the destination path, then create this folder.",
                  "color": "muted"
                },
                {
                  "type": "textField",
                  "bind": "{{path}}",
                  "label": "Destination path",
                  "required": true
                }
              ]
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
                  "role": "cancel"
                },
                {
                  "label": "Create folder",
                  "role": "confirm",
                  "color": "accent"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "copy_item",
      "title": "Copy file or folder",
      "description": "Copy file or folder via Composio OAuth2. Use when the user asks to copy a Dropbox file or folder to an exact destination. Returns provider data including pagination; never infer all pages were read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from_path": {
            "type": "string"
          },
          "to_path": {
            "type": "string"
          }
        },
        "required": [
          "from_path",
          "to_path"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      },
      "confirmation": {
        "schemaVersion": 1,
        "root": {
          "type": "card",
          "title": "Copy file or folder",
          "children": [
            {
              "type": "stack",
              "direction": "vertical",
              "gap": "md",
              "children": [
                {
                  "type": "text",
                  "text": "Review the exact source and destination before continuing.",
                  "color": "muted"
                },
                {
                  "type": "textField",
                  "bind": "{{from_path}}",
                  "label": "Source path",
                  "required": true
                },
                {
                  "type": "textField",
                  "bind": "{{to_path}}",
                  "label": "Destination path",
                  "required": true
                }
              ]
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
                  "role": "cancel"
                },
                {
                  "label": "Copy file or folder",
                  "role": "confirm",
                  "color": "accent"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "move_item",
      "title": "Move file or folder",
      "description": "Move file or folder via Composio OAuth2. Use when the user asks to move or rename a Dropbox file or folder. Returns provider data including pagination; never infer all pages were read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from_path": {
            "type": "string"
          },
          "to_path": {
            "type": "string"
          }
        },
        "required": [
          "from_path",
          "to_path"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      },
      "confirmation": {
        "schemaVersion": 1,
        "root": {
          "type": "card",
          "title": "Move file or folder",
          "children": [
            {
              "type": "stack",
              "direction": "vertical",
              "gap": "md",
              "children": [
                {
                  "type": "text",
                  "text": "Review the exact source and destination before continuing.",
                  "color": "muted"
                },
                {
                  "type": "textField",
                  "bind": "{{from_path}}",
                  "label": "Source path",
                  "required": true
                },
                {
                  "type": "textField",
                  "bind": "{{to_path}}",
                  "label": "Destination path",
                  "required": true
                }
              ]
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
                  "role": "cancel"
                },
                {
                  "label": "Move file or folder",
                  "role": "confirm",
                  "color": "accent"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "delete_item",
      "title": "Delete file or folder",
      "description": "Delete file or folder via Composio OAuth2. Use when the user asks to delete a Dropbox file or folder; recovery depends on the account plan. Returns provider data including pagination; never infer all pages were read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      },
      "confirmation": {
        "schemaVersion": 1,
        "root": {
          "type": "card",
          "title": "Delete file or folder",
          "children": [
            {
              "type": "stack",
              "direction": "vertical",
              "gap": "md",
              "children": [
                {
                  "type": "text",
                  "text": "Deletes this item and everything inside it. Recovery depends on your Dropbox plan.",
                  "color": "muted"
                },
                {
                  "type": "textField",
                  "bind": "{{path}}",
                  "label": "File or folder path",
                  "required": true
                }
              ]
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
                  "role": "cancel"
                },
                {
                  "label": "Delete file or folder",
                  "role": "confirm",
                  "color": "accent"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "list_revisions",
      "title": "List file revisions",
      "description": "List file revisions via Composio OAuth2. Use when the user asks to inspect previous versions before restoring a Dropbox file. Returns provider data including pagination; never infer all pages were read. The card already shows the returned items. Keep default narration brief and do not repeat the entire list unless the user explicitly asks for those details.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      }
    },
    {
      "name": "restore_revision",
      "title": "Restore file to specific revision",
      "description": "Restore file to specific revision via Composio OAuth2. Use when the user asks to restore a Dropbox file to the exact revision the user selected. Returns provider data including pagination; never infer all pages were read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "rev": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "rev"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      },
      "confirmation": {
        "schemaVersion": 1,
        "root": {
          "type": "card",
          "title": "Restore file to specific revision",
          "children": [
            {
              "type": "stack",
              "direction": "vertical",
              "gap": "md",
              "children": [
                {
                  "type": "text",
                  "text": "Replaces the current file with the exact revision below.",
                  "color": "muted"
                },
                {
                  "type": "textField",
                  "bind": "{{path}}",
                  "label": "File or folder path",
                  "required": true
                },
                {
                  "type": "textField",
                  "bind": "{{rev}}",
                  "label": "Revision ID",
                  "required": true
                }
              ]
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
                  "role": "cancel"
                },
                {
                  "label": "Restore file to specific revision",
                  "role": "confirm",
                  "color": "accent"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "create_shared_link",
      "title": "Create shared link",
      "description": "Create shared link via Composio OAuth2. Use when the user asks to create a shared link after approving the access change. Returns provider data including pagination; never infer all pages were read. Shared links are already available through the card Open/Copy controls. Use the returned summary for a brief reply; do not rebuild the URL or print it in a second formatted response. Reuse the exact returned URL for revocation. Never repeat a completed write because narration formatting failed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      },
      "confirmation": {
        "schemaVersion": 1,
        "root": {
          "type": "card",
          "title": "Create shared link",
          "children": [
            {
              "type": "stack",
              "direction": "vertical",
              "gap": "md",
              "children": [
                {
                  "type": "text",
                  "text": "Creates a link using the default access settings for your Dropbox account.",
                  "color": "muted"
                },
                {
                  "type": "textField",
                  "bind": "{{path}}",
                  "label": "File or folder path",
                  "required": true
                }
              ]
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
                  "role": "cancel"
                },
                {
                  "label": "Create shared link",
                  "role": "confirm",
                  "color": "accent"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "list_shared_links",
      "title": "List shared links",
      "description": "List shared links via Composio OAuth2. Use when the user asks to inspect existing Dropbox shared links. Returns provider data including pagination; never infer all pages were read. Shared links are already available through the card Open/Copy controls. Use the returned summary for a brief reply; do not rebuild the URL or print it in a second formatted response. Reuse the exact returned URL for revocation. Never repeat a completed write because narration formatting failed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      }
    },
    {
      "name": "revoke_shared_link",
      "title": "Revoke shared link",
      "description": "Revoke shared link via Composio OAuth2. Use when the user asks to revoke the exact Dropbox shared link selected by the user. Returns provider data including pagination; never infer all pages were read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      },
      "confirmation": {
        "schemaVersion": 1,
        "root": {
          "type": "card",
          "title": "Revoke shared link",
          "children": [
            {
              "type": "stack",
              "direction": "vertical",
              "gap": "md",
              "children": [
                {
                  "type": "text",
                  "text": "People using this link will lose access through it.",
                  "color": "muted"
                },
                {
                  "type": "textField",
                  "bind": "{{url}}",
                  "label": "Shared link",
                  "required": true
                }
              ]
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
                  "role": "cancel"
                },
                {
                  "label": "Revoke shared link",
                  "role": "confirm",
                  "color": "accent"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "connect_account",
      "title": "Connect Dropbox",
      "description": "Connect Dropbox through Composio OAuth2. Use when the user asks to connect or authorize their Dropbox account. Opens browser consent and verifies the connection; does not change Dropbox files.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "execution": {
        "mode": "background"
      },
