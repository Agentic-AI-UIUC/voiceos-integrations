                {
                  "type": "text",
                  "text": "Open secure Composio OAuth2 authorization in your browser and connect Dropbox.",
                  "color": "muted"
                }
              ]
            }
          ],
          "footer": [
            {
              "type": "actions",
              "items": [
                {
                  "label": "Cancel",
