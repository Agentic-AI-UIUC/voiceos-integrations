# Copy to .env for local runs (bun server.ts). VoiceOS injects these from the
# integration settings, so a published install never reads this file.

# Composio API key (starts with ak_) from https://app.composio.dev/settings
COMPOSIO_API_KEY=

# Optional: Composio user ID that owns the OneDrive connection
COMPOSIO_USER_ID=default

# Optional: pin a specific connected account (starts with ca_); blank = auto-detect
COMPOSIO_CONNECTED_ACCOUNT_ID=

# Optional: card theme — auto (follow VoiceOS), dark (black), or light (white)
CARD_THEME=auto
