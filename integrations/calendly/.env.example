# Copy to .env and fill in. .env holds a secret: never share or commit it.
# The Calendly integration's settings in VoiceOS override these when filled.

# Composio project API key (platform.composio.dev -> Settings -> API Keys).
COMPOSIO_API_KEY=

# The Composio user ID Calendly is connected under (platform.composio.dev ->
# Connected Accounts). Defaults to "default".
COMPOSIO_USER_ID=default

# Optional: which Calendly auth config to connect through, if your Composio
# project has several. Leave blank to pick it automatically.
COMPOSIO_AUTH_CONFIG_ID=
