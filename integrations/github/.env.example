# Every setting this integration reads. In VoiceOS you enter them under
# Integrations → GitHub → Configure, and VoiceOS passes each one to server.ts
# as an environment variable with the same name. You only need a .env file to
# run server.ts by hand. Never commit .env.

# Required. Composio project API key: composio.dev → Settings → Project
# Settings → API Keys. Use a project key, not a ck_ consumer key or a uak_ user
# key. A scoped key needs Auth configs, Connected accounts and Session
# management (read and write), and Session tool execution (write).
COMPOSIO_PROJECT_API_KEY=

# Optional. "Use my GitHub connection" (default true). Set to false to
# disconnect: the server stops using the account and asks Composio to revoke it.
GITHUB_CONNECTION=true

# Optional. Leave blank to sign in through Composio's GitHub app. To show your
# own GitHub OAuth app instead, put its Composio auth config ID here (ac_...).
# It must ask only for the repo scope.
COMPOSIO_GITHUB_AUTH_CONFIG_ID=
